# Valley Meats voice agent
# FREE hosted AI (no card): get a key at https://console.groq.com/keys and set:
# GROQ_API_KEY=            # uses llama-3.3-70b-versatile; any OpenAI-compatible API works via LLM_BASE_URL/LLM_MODEL/LLM_API_KEY
# AI brain: with no ANTHROPIC_API_KEY it uses a FREE local model through Ollama
# (install from ollama.com, then: ollama pull qwen3:8b). Force one with LLM_PROVIDER=ollama|anthropic.
# OLLAMA_MODEL=qwen3:8b      # qwen3:14b is better if your machine can run it; llama3.2:3b for weak machines
# OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=      # Claude (optional if using Ollama)
# Optional premium voice (leave blank to use the free built-in browser voices):
ELEVENLABS_API_KEY=     # ElevenLabs: natural spoken replies (works on its own; mic stays the free browser one)
OPENAI_API_KEY=         # Whisper: better speech-to-text (optional)
# Optional
# ANTHROPIC_MODEL=claude-opus-5-5     # claude-sonnet-5-5 is faster/cheaper for voice
# OPENAI_STT_MODEL=whisper-1
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# STRIPE_SECRET_KEY=    # enables "pay online" via a Stripe Checkout link
# APP_URL=https://your-site.com   # origin for payment redirects (defaults to request origin)
# WHERE ORDERS GO (at least one is REQUIRED in production, otherwise orders are refused):
# ORDER_SLACK_WEBHOOK_URL=   # Slack or Discord incoming webhook: a readable ticket appears in a channel
# RESEND_API_KEY=            # email tickets via resend.com
# ORDER_EMAIL_TO=kitchen@your-domain.com   # comma-separated
# ORDER_EMAIL_FROM="Valley Meats Orders <orders@your-domain.com>"
# ORDER_WEBHOOK_URL=         # JSON POST to your POS / kitchen system
# ORDER_WEBHOOK_SECRET=
# ALLOW_LOG_ONLY_ORDERS=1    # NOT for production: lets orders succeed with only a server log line
#
# COST / ABUSE PROTECTION (also set spend limits in each provider's dashboard):
# DAILY_AI_CALL_LIMIT=2000   # all customers together, per day
# DAILY_VOICE_CALL_LIMIT=3000
# UPSTASH_REDIS_REST_URL=    # shared rate limits across serverless instances (upstash.com, free tier)
# UPSTASH_REDIS_REST_TOKEN=

# Public site URL (canonical links, sitemap, schema.org, llms.txt). Set to your real domain in production.
# SITE_URL=https://your-domain.com
